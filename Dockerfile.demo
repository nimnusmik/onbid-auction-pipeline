# Public read-only demo: Flask API + Next.js + DB snapshot in one container (Hugging Face Spaces, port 7860).
FROM node:20-slim AS web
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG NEXT_PUBLIC_KAKAO_MAP_KEY=""
ENV NEXT_PUBLIC_KAKAO_MAP_KEY=$NEXT_PUBLIC_KAKAO_MAP_KEY \
    API_INTERNAL=http://127.0.0.1:8000
RUN npm run build && npm prune --omit=dev

FROM python:3.12-slim
COPY --from=web /usr/local/bin/node /usr/local/bin/node
ENV TZ=Asia/Seoul DEMO_MODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn==21.2.0
COPY api/ ./api/
COPY collector/ ./collector/
COPY db/ ./db/
COPY processor/ ./processor/
COPY notifier/ ./notifier/
COPY data/onbid.db ./data/onbid.db
COPY --from=web /app ./frontend
RUN useradd -m -u 1000 user && chown -R user /app
USER user
ENV PORT=7860
EXPOSE 7860
CMD gunicorn -w 1 -b 127.0.0.1:8000 --chdir api app:app & \
    cd frontend && exec node node_modules/next/dist/bin/next start -H 0.0.0.0 -p $PORT
